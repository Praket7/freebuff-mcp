{
  "name": "freebuff-mcp",
  "version": "0.1.12",
  "description": "A secure MCP bridge for locally installed Freebuff Desktop and CLI sessions.",
  "keywords": [
    "mcp",
    "freebuff",
    "codex",
    "ai",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Praket7/freebuff-mcp.git"
  },
  "homepage": "https://github.com/Praket7/freebuff-mcp#readme",
  "bugs": {
    "url": "https://github.com/Praket7/freebuff-mcp/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "freebuff-mcp": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "PRIVACY.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx test/**/*.test.ts",
    "pack:check": "pnpm build && pnpm pack --pack-destination work"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "node-pty": "1.2.0-beta.15",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
